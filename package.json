{
  "name": "dsh-blender-preview",
  "version": "0.3.0",
  "description": "Files-tab previews for DeepSeek Harness: .blend (headless local Blender export to a cached GLB), .glb/.gltf/.obj in a WebGL viewport, plus .svg, video and audio; depends on dsh-blender with a read-only boot self-check; no network calls, no telemetry, no postinstall; uninstall removes the row.",
  "dependencies": {
    "dsh-blender": "^0.2.4"
  },
  "devDependencies": {
    "esbuild-wasm": "^0.28.2",
    "three": "^0.187.0"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "build.mjs",
    "cordis.patch.yml",
    "scripts/test-harness.mjs",
    "scripts/make-banner.py",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "assets/icon.png",
    "assets/banner-icon.png",
    "assets/banner-light.png",
    "assets/banner-dark.png",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node scripts/test-harness.mjs && node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "blender",
    "blend",
    "glb",
    "preview",
    "3d",
    "webgl"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adithyanraj03/dsh-blender-preview.git"
  },
  "homepage": "https://adithyanraj03.github.io/dsh-blender-preview/",
  "bugs": {
    "url": "https://github.com/adithyanraj03/dsh-blender-preview/issues"
  },
  "author": {
    "name": "Adithya N Raj",
    "url": "https://github.com/adithyanraj03"
  },
  "icon": "assets/icon.png",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
