{
  "name": "dsh-blender-preview",
  "version": "0.2.0",
  "description": "Scaffold for a DeepSeek Harness Blender preview plugin: one host row, no UI yet, no network calls, no telemetry; depends on dsh-blender@^0.2.4 (at boot it only checks that dsh-blender is installed and mounted in the profiles that use it, logging the exact mount command when not — non-mutating); planned feature: .blend to cached local GLB via local Blender; no postinstall; uninstall removes the row.",
  "dependencies": {
    "dsh-blender": "^0.2.4"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/client.js",
    "cordis.patch.yml",
    "scripts/test-harness.mjs",
    "scripts/make-banner.py",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "assets/icon.png",
    "assets/banner-icon.png",
    "assets/banner-light.png",
    "assets/banner-dark.png",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/test-harness.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-api-workspace-files"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "blender",
    "blend",
    "glb",
    "preview",
    "3d",
    "webgl"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adithyanraj03/dsh-blender-preview.git"
  },
  "homepage": "https://adithyanraj03.github.io/dsh-blender-preview/",
  "bugs": {
    "url": "https://github.com/adithyanraj03/dsh-blender-preview/issues"
  },
  "author": {
    "name": "Adithya N Raj",
    "url": "https://github.com/adithyanraj03"
  },
  "icon": "assets/icon.png",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
